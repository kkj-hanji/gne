Set-Location "D:\testings\gndec"

$branch = git branch --show-current
$changes = git status --porcelain

if (-not $changes) {
  Write-Host "No Git changes to push."
  exit 0
}

git add -A
git commit -m "chore: sync project changes $(Get-Date -Format 'yyyy-MM-dd HH:mm')"
git push origin $branch

Write-Host "Pushed all changes to origin/$branch"