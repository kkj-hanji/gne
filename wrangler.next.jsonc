{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gndec-compass-next",
  "main": "src/next-worker.js",
  "compatibility_date": "2026-08-11",
  "vars": {
    "APP_VERSION": "2.0.0",
    "APP_CHANNEL": "stable",
    "BUILD_TIME": "2026-11-09",
    "PUBLIC_ORIGIN": "https://gndec-compass-next.koush3069.workers.dev",
    "LEGACY_ORIGIN": "https://gndec-compass.koush3069.workers.dev"
  },
  "assets": {
    "directory": "next",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/api/*", "/today", "/timetable", "/rooms", "/ask", "/notices", "/directory", "/compare", "/settings"],
    "not_found_handling": "single-page-application"
  },
  "services": [
    {
      "binding": "LEGACY",
      "service": "gndec-compass"
    }
  ],
  "observability": {
    "enabled": true
  }
}
